{
  "name": "kharon-relay",
  "private": true,
  "version": "0.1.0",
  "description": "KHARON//RELAY — clicker 3D sur une station spatiale abandonnée, avec filtres ASCII et réparations par programmation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage",
    "assets:meshy": "node scripts/meshy/generate.mjs",
    "assets:meshy:plan": "node scripts/meshy/generate.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
