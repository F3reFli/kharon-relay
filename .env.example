# Clé API Meshy (https://www.meshy.ai/settings/api) — utilisée uniquement par `npm run assets:meshy`.
# Copier ce fichier en `.env` et renseigner la clé. Ne jamais committer `.env`.
MESHY_API_KEY=
# Plafond de crédits Meshy pour un lancement du script (refus si l'estimation dépasse).
MESHY_BUDGET=100
